# Copy to .env.local and fill in. Never commit real values.

# ScrapeCreators (TikTok search + transcripts)
SCRAPE_CREATORS_API_KEY=

# Gemini (video analysis, phase 3)
GEMINI_API_KEY=

# Supabase. Server-only: never expose the secret key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
# New-style secret key (sb_secret_...). The legacy SUPABASE_SERVICE_ROLE_KEY also works if set instead.
SUPABASE_SECRET_KEY=
# Database password, only needed to apply migrations from the CLI.
SUPABASE_DB_PW=

# Days to keep downloaded MP4s in storage before cleanup deletes them (default 30).
VIDEO_RETENTION_DAYS=30

# Gemini model and media resolution for video analysis (low | medium | high).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MEDIA_RESOLUTION=low

# Basic auth for the whole app (required on Vercel; leave blank locally to skip auth).
APP_USERNAME=
APP_PASSWORD=
